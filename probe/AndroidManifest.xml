<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.beampro.portprobe" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />
    <uses-permission android:name="android.permission.CAPTURE_SECURE_VIDEO_OUTPUT" />
    <uses-permission android:name="android.permission.ADD_TRUSTED_DISPLAY" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <application android:label="Beam Port Probe" android:debuggable="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider android:name=".PortBridgeProvider" android:authorities="dev.beampro.portprobe.bridge" android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FixtureActivity" android:exported="false" android:resizeableActivity="true" android:configChanges="orientation|screenSize" />
        <activity android:name=".EmbeddedFixtureActivity" android:exported="false" android:allowEmbedded="true" android:resizeableActivity="true" android:configChanges="orientation|screenSize" />
        <activity android:name=".BridgeCheckActivity" android:exported="true" android:configChanges="orientation|screenSize" />
    </application>
</manifest>
